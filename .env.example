# LoveByte Frontend Environment Variables
# Production backend (deployed on Render):
EXPO_PUBLIC_API_URL=https://lovebyte-real-time-chat-app.onrender.com
EXPO_PUBLIC_SOCKET_URL=https://lovebyte-real-time-chat-app.onrender.com

# For local development with Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:5000

# For local development with physical Android device on LAN:
# EXPO_PUBLIC_API_URL=http://<YOUR_COMPUTER_LAN_IP>:5000
# EXPO_PUBLIC_SOCKET_URL=http://<YOUR_COMPUTER_LAN_IP>:5000


